#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"$SCRIPT_DIR/preflight"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

printf 'Starting MVP-0 PostgreSQL service (non-destructive; volume is preserved).\n'
# Recreate the scoped container so a fresh clone's bind-mounted init script is
# authoritative, while the named postgres-data volume remains untouched.
mvp0_compose up --detach --wait --force-recreate postgres
mvp0_run_init_script ensure
mvp0_run_init_script verify
printf 'MVP-0 PostgreSQL is ready. Use scripts/mvp0/demo to start the deterministic API/Web demo.\n'
