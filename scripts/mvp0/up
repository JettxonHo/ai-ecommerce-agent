#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"$SCRIPT_DIR/preflight"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

printf 'Starting MVP-0 PostgreSQL service (non-destructive; volume is preserved).\n'
mvp0_compose up --detach --wait postgres
mvp0_run_init_script ensure
mvp0_run_init_script verify
printf 'MVP-0 PostgreSQL is ready. API/Worker/Web are host-process boundaries and are not started by this task.\n'
