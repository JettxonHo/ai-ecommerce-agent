#!/usr/bin/env bash
set -Eeuo pipefail

# Fast, offline regression coverage for the local demo shell lifecycle. The
# harness executes copies of the production scripts against bounded fake
# Docker/host processes, so it never needs a daemon, a real database, or a
# network listener.
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

assert_contains() {
  local needle="$1"
  local haystack="$2"
  [[ "$haystack" == *"$needle"* ]] || fail "expected output to contain: $needle"
}

assert_not_contains() {
  local needle="$1"
  local haystack="$2"
  [[ "$haystack" != *"$needle"* ]] || fail "unexpected output: $needle"
}

assert_not_running() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || fail "missing process marker: $pid_file"
  local pid
  pid="$(<"$pid_file")"
  if kill -0 "$pid" >/dev/null 2>&1; then
    fail "orphan process remains: $pid"
  fi
}

SANDBOX="$(mktemp -d "${TMPDIR:-/tmp}/mvp0-lifecycle.XXXXXX")"
cleanup() {
  rm -rf "$SANDBOX"
}
trap cleanup EXIT

mkdir -p "$SANDBOX/scripts/mvp0" \
  "$SANDBOX/apps/backend" \
  "$SANDBOX/apps/web/node_modules/.bin" \
  "$SANDBOX/fake-bin"
cp "$SCRIPT_DIR/../../apps/web/package.json" "$SANDBOX/apps/web/package.json"
printf 'services:\n  postgres:\n    image: postgres:16.14-bookworm\n' >"$SANDBOX/compose.yaml"
cp "$SCRIPT_DIR/lib.sh" "$SCRIPT_DIR/preflight" "$SCRIPT_DIR/demo" \
  "$SCRIPT_DIR/up" "$SCRIPT_DIR/migrate-business" "$SANDBOX/scripts/mvp0/"
chmod +x "$SANDBOX/scripts/mvp0"/*

REAL_PYTHON="$(command -v python3)"
cat >"$SANDBOX/fake-bin/docker" <<'FAKE_DOCKER'
#!/usr/bin/env bash
set -Eeuo pipefail
printf 'docker %s [scope=%s volume=%s]\n' "$*" \
  "${MVP0_COMPOSE_PROJECT:-unset}" "${MVP0_POSTGRES_VOLUME_NAME:-unset}" \
  >>"${MVP0_TEST_DOCKER_LOG:?}"
if [[ "${1:-}" != compose ]]; then
  [[ "${1:-}" == info ]] && exit 0
  exit 0
fi
shift
while (($#)); do
  case "$1" in
    --project-name|--file|--env-file)
      shift 2
      ;;
    *)
      break
      ;;
  esac
done
command_name="${1:-}"
shift || true
case "$command_name" in
  version)
    if [[ "${1:-}" == --short ]]; then
      printf '2.40.0\n'
    else
      printf 'Docker Compose version v2.40.0\n'
    fi
    ;;
  config)
    case " $* " in
      *' --images '*) printf 'postgres:16.14-bookworm\n' ;;
      *' --services '*) printf 'postgres\n' ;;
      *' --volumes '*) printf 'postgres-data\n' ;;
      *' --format json '*|*' --format=json '*)
        printf '%s\n' '{"services":{"postgres":{"environment":{"MVP0_BUSINESS_DB":"mvp0_business","MVP0_BUSINESS_ROLE":"mvp0_business","MVP0_BUSINESS_PASSWORD":"mvp0_business_local_only"},"ports":[{"host_ip":"127.0.0.1","published":55432}]}}}'
        ;;
      *) ;;
    esac
    ;;
  *) ;;
esac
FAKE_DOCKER
cat >"$SANDBOX/fake-bin/node" <<'FAKE_NODE'
#!/usr/bin/env bash
printf 'v%s\n' "${MVP0_TEST_NODE_VERSION:-24.18.0}"
FAKE_NODE
cat >"$SANDBOX/fake-bin/npm" <<'FAKE_NPM'
#!/usr/bin/env bash
printf '%s\n' "${MVP0_TEST_NPM_VERSION:-11.16.0}"
FAKE_NPM
cat >"$SANDBOX/fake-bin/uv" <<'FAKE_UV'
#!/usr/bin/env bash
set -Eeuo pipefail
if [[ " $* " == *' --version '* ]]; then
  printf 'uv 0.12.8\n'
  exit 0
fi
if [[ " $* " == *' alembic '* ]]; then
  exit 0
fi
if [[ " $* " == *' uvicorn '* ]]; then
  printf '%s\n' "$$" >"${MVP0_TEST_API_PID:?}"
  : >"${MVP0_TEST_API_STARTED:?}"
  while :; do /bin/sleep 1; done
fi
exit 0
FAKE_UV
cat >"$SANDBOX/fake-bin/python3" <<FAKE_PYTHON
#!/usr/bin/env bash
if [[ " \$* " == *'sys.version_info'* ]]; then
  printf '3.13.5\n'
  exit 0
fi
exec "$REAL_PYTHON" "\$@"
FAKE_PYTHON
cat >"$SANDBOX/fake-bin/curl" <<'FAKE_CURL'
#!/usr/bin/env bash
set -Eeuo pipefail
url="${!#}"
case "$url" in
  *:8000/*)
    printf 'api\n' >>"${MVP0_TEST_CURL_LOG:?}"
    [[ -f "${MVP0_TEST_API_STARTED:?}" ]] || exit 22
    ;;
  *:5173/*)
    printf 'web\n' >>"${MVP0_TEST_CURL_LOG:?}"
    [[ -f "${MVP0_TEST_WEB_STARTED:?}" ]] || exit 22
    ;;
  *) exit 22 ;;
esac
FAKE_CURL
cat >"$SANDBOX/fake-bin/lsof" <<'FAKE_LSOF'
#!/usr/bin/env bash
if [[ -n "${MVP0_TEST_OCCUPIED_PORT:-}" && "$*" == *":${MVP0_TEST_OCCUPIED_PORT}"* ]]; then
  exit 0
fi
exit 1
FAKE_LSOF
cat >"$SANDBOX/apps/web/node_modules/.bin/vite" <<'FAKE_VITE'
#!/usr/bin/env bash
set -Eeuo pipefail
printf '%s\n' "$$" >"${MVP0_TEST_WEB_PID:?}"
: >"${MVP0_TEST_WEB_STARTED:?}"
if [[ "${MVP0_TEST_WEB_FAIL:-0}" == 1 ]]; then
  /bin/sleep 1
  exit 17
fi
while :; do /bin/sleep 1; done
FAKE_VITE
chmod +x "$SANDBOX/fake-bin"/* "$SANDBOX/apps/web/node_modules/.bin/vite"

FAKE_PATH="$SANDBOX/fake-bin:$PATH"
preflight_env=(
  PATH="$FAKE_PATH"
  MVP0_TEST_DOCKER_LOG="$SANDBOX/docker.log"
)

set +e
negative_output="$(env "${preflight_env[@]}" MVP0_TEST_NODE_VERSION=22.15.1 MVP0_TEST_NPM_VERSION=10.9.2 \
  "$SANDBOX/scripts/mvp0/preflight" --host-processes 2>&1)"
negative_status=$?
set -e
(( negative_status != 0 )) || fail 'Node 22/npm 10 preflight unexpectedly passed'
assert_contains 'Node.js 24.18.0' "$negative_output"
assert_not_contains 'MVP-0 local PostgreSQL preflight: PASS' "$negative_output"

set +e
npm_negative_output="$(env "${preflight_env[@]}" MVP0_TEST_NODE_VERSION=24.18.0 MVP0_TEST_NPM_VERSION=10.9.2 \
  "$SANDBOX/scripts/mvp0/preflight" --host-processes 2>&1)"
npm_negative_status=$?
set -e
(( npm_negative_status != 0 )) || fail 'Node 24/npm 10 preflight unexpectedly passed'
assert_contains 'npm 11.16.0' "$npm_negative_output"
assert_not_contains 'MVP-0 local PostgreSQL preflight: PASS' "$npm_negative_output"

positive_output="$(env "${preflight_env[@]}" \
  "$SANDBOX/scripts/mvp0/preflight" --host-processes 2>&1)" || fail 'pinned Node/npm preflight failed'
assert_contains 'MVP-0 local PostgreSQL preflight: PASS' "$positive_output"
assert_contains 'Node v24.18.0, npm 11.16.0' "$positive_output"

occupied_log="$SANDBOX/occupied-docker.log"
set +e
occupied_output="$(env "${preflight_env[@]}" MVP0_TEST_DOCKER_LOG="$occupied_log" \
  MVP0_TEST_OCCUPIED_PORT=8000 "$SANDBOX/scripts/mvp0/demo" 2>&1)"
occupied_status=$?
set -e
(( occupied_status != 0 )) || fail 'occupied-port demo unexpectedly passed'
assert_contains 'loopback port 8000 is already in use' "$occupied_output"
if grep -Eq 'docker .* up ' "$occupied_log" 2>/dev/null; then
  fail 'occupied-port failure started PostgreSQL'
fi

run_demo() {
  local output_file="$1"
  local docker_log="$2"
  shift 2
  local -a demo_command=("$SANDBOX/scripts/mvp0/demo")
  if (($#)); then
    demo_command+=("$@")
  fi
  env "${preflight_env[@]}" MVP0_TEST_DOCKER_LOG="$docker_log" \
    MVP0_TEST_WEB_FAIL="${MVP0_TEST_WEB_FAIL:-0}" \
    MVP0_TEST_CURL_LOG="$SANDBOX/curl.log" \
    MVP0_TEST_API_PID="$SANDBOX/api.pid" \
    MVP0_TEST_WEB_PID="$SANDBOX/web.pid" \
    MVP0_TEST_API_STARTED="$SANDBOX/api.started" \
    MVP0_TEST_WEB_STARTED="$SANDBOX/web.started" \
    "${demo_command[@]}" >"$output_file" 2>&1 &
  demo_pid="$!"
}

rm -f "$SANDBOX/curl.log" "$SANDBOX/api.pid" "$SANDBOX/web.pid" \
  "$SANDBOX/api.started" "$SANDBOX/web.started"
demo_output="$SANDBOX/demo.log"
run_demo "$demo_output" "$SANDBOX/demo-docker.log"
for _ in {1..20}; do
  grep -Fq 'Browser URL: http://127.0.0.1:5173/tasks' "$demo_output" 2>/dev/null && break
  /bin/sleep 0.2
done
grep -Fq 'Browser URL: http://127.0.0.1:5173/tasks' "$demo_output" || fail 'demo never reached browser readiness'
readiness="$(tr '\n' ' ' <"$SANDBOX/curl.log")"
[[ "$readiness" == 'api web ' ]] || fail "unexpected readiness order: ${readiness:-<none>}"
# Terminate one fake child after both endpoints are ready. The production
# monitor must detect the child failure and clean up the sibling process.
kill -TERM "$(<"$SANDBOX/web.pid")"
set +e
wait "$demo_pid"
demo_status=$?
set -e
(( demo_status != 0 )) || fail 'child failure demo unexpectedly passed'
assert_not_running "$SANDBOX/api.pid"
assert_not_running "$SANDBOX/web.pid"
default_docker_log="$(<"$SANDBOX/demo-docker.log")"
assert_contains '--project-name ai-ecommerce-agent-mvp0' "$default_docker_log"
assert_contains 'volume=ai-ecommerce-agent-mvp0-postgres-data' "$default_docker_log"
assert_not_contains 'down --volumes' "$default_docker_log"
assert_not_contains 'ephemeral-' "$default_docker_log"

# Characterize the copied production scope guard directly. Every invalid
# ephemeral volume identity must fail before mvp0_compose reaches fake Docker;
# the paired value remains the only value allowed to reach destructive cleanup.
scope_project='ai-ecommerce-agent-mvp0-ephemeral-260824123456-12345-54321'
scope_default_volume='ai-ecommerce-agent-mvp0-postgres-data'
scope_probe_invalid() {
  local case_name="$1"
  local value_mode="$2"
  local value="${3:-}"
  local docker_log="$SANDBOX/scope-${case_name}.docker.log"
  rm -f "$docker_log"

  set +e
  if [[ "$value_mode" == unset ]]; then
    env -u MVP0_POSTGRES_VOLUME_NAME PATH="$FAKE_PATH" \
      MVP0_COMPOSE_PROJECT="$scope_project" MVP0_TEST_DOCKER_LOG="$docker_log" \
      bash -c 'set -Eeuo pipefail; source "$1/lib.sh"; mvp0_compose down --volumes --remove-orphans' \
      _ "$SANDBOX/scripts/mvp0"
  else
    env PATH="$FAKE_PATH" MVP0_COMPOSE_PROJECT="$scope_project" \
      MVP0_POSTGRES_VOLUME_NAME="$value" MVP0_TEST_DOCKER_LOG="$docker_log" \
      bash -c 'set -Eeuo pipefail; source "$1/lib.sh"; mvp0_compose down --volumes --remove-orphans' \
      _ "$SANDBOX/scripts/mvp0"
  fi
  local status=$?
  set -e
  (( status != 0 )) || fail "invalid ${case_name} scope unexpectedly passed"
  [[ ! -s "$docker_log" ]] ||
    fail "invalid ${case_name} scope reached fake Docker"
}

scope_probe_invalid unset unset
scope_probe_invalid empty value ''
scope_probe_invalid default value "$scope_default_volume"
scope_probe_invalid mismatch value "${scope_project}-wrong"

scope_paired_log="$SANDBOX/scope-paired.docker.log"
env PATH="$FAKE_PATH" MVP0_COMPOSE_PROJECT="$scope_project" \
  MVP0_POSTGRES_VOLUME_NAME="${scope_project}-pg" \
  MVP0_TEST_DOCKER_LOG="$scope_paired_log" \
  bash -c 'set -Eeuo pipefail; source "$1/lib.sh"; mvp0_compose down --volumes --remove-orphans' \
  _ "$SANDBOX/scripts/mvp0"
scope_paired_docker_log="$(<"$scope_paired_log")"
assert_contains 'down --volumes --remove-orphans' "$scope_paired_docker_log"
assert_contains "volume=${scope_project}-pg" "$scope_paired_docker_log"

ephemeral_port_log="$SANDBOX/ephemeral-port-docker.log"
set +e
ephemeral_port_output="$(env "${preflight_env[@]}" MVP0_TEST_DOCKER_LOG="$ephemeral_port_log" \
  MVP0_TEST_OCCUPIED_PORT=8000 "$SANDBOX/scripts/mvp0/demo" --ephemeral 2>&1)"
ephemeral_port_status=$?
set -e
(( ephemeral_port_status != 0 )) || fail 'ephemeral occupied-port demo unexpectedly passed'
assert_contains 'loopback port 8000 is already in use' "$ephemeral_port_output"
if grep -Eq 'docker .* up ' "$ephemeral_port_log" 2>/dev/null; then
  fail 'ephemeral occupied-port failure started PostgreSQL'
fi

rm -f "$SANDBOX/curl.log" "$SANDBOX/api.pid" "$SANDBOX/web.pid" \
  "$SANDBOX/api.started" "$SANDBOX/web.started"
ephemeral_error_log="$SANDBOX/ephemeral-error-docker.log"
ephemeral_error_output="$SANDBOX/ephemeral-error.log"
set +e
MVP0_TEST_WEB_FAIL=1 run_demo "$ephemeral_error_output" "$ephemeral_error_log" --ephemeral
ephemeral_error_pid="$demo_pid"
wait "$ephemeral_error_pid"
ephemeral_error_status=$?
set -e
(( ephemeral_error_status != 0 )) || fail 'ephemeral child failure unexpectedly passed'
assert_not_running "$SANDBOX/api.pid"
assert_not_running "$SANDBOX/web.pid"
ephemeral_error_docker_log="$(<"$ephemeral_error_log")"
assert_contains 'down --volumes --remove-orphans' "$ephemeral_error_docker_log"
assert_contains 'volume=ai-ecommerce-agent-mvp0-ephemeral-' "$ephemeral_error_docker_log"
assert_not_contains 'volume=ai-ecommerce-agent-mvp0-postgres-data' "$ephemeral_error_docker_log"
ephemeral_error_project="$(sed -n 's/.*--project-name \([^ ]*\).*/\1/p' "$ephemeral_error_log" | tail -n 1)"
[[ "$ephemeral_error_project" == ai-ecommerce-agent-mvp0-ephemeral-* ]] ||
  fail "unexpected ephemeral project: ${ephemeral_error_project:-<none>}"
ephemeral_error_volume="$(sed -n 's/.*volume=\([^]]*\).*/\1/p' "$ephemeral_error_log" | tail -n 1)"
[[ "$ephemeral_error_volume" == "${ephemeral_error_project}-pg" ]] ||
  fail "unexpected error volume: ${ephemeral_error_volume:-<none>}"

rm -f "$SANDBOX/curl.log" "$SANDBOX/api.pid" "$SANDBOX/web.pid" \
  "$SANDBOX/api.started" "$SANDBOX/web.started"
ephemeral_signal_log="$SANDBOX/ephemeral-signal-docker.log"
ephemeral_signal_output="$SANDBOX/ephemeral-signal.log"
run_demo "$ephemeral_signal_output" "$ephemeral_signal_log" --ephemeral
ephemeral_signal_pid="$demo_pid"
for _ in {1..20}; do
  grep -Fq 'Browser URL: http://127.0.0.1:5173/tasks' "$ephemeral_signal_output" 2>/dev/null && break
  /bin/sleep 0.2
done
grep -Fq 'Browser URL: http://127.0.0.1:5173/tasks' "$ephemeral_signal_output" ||
  fail 'ephemeral signal demo never reached browser readiness'
kill -TERM "$ephemeral_signal_pid"
set +e
wait "$ephemeral_signal_pid"
ephemeral_signal_status=$?
set -e
(( ephemeral_signal_status == 130 )) ||
  fail "ephemeral signal demo returned ${ephemeral_signal_status}, expected 130"
assert_not_running "$SANDBOX/api.pid"
assert_not_running "$SANDBOX/web.pid"
ephemeral_signal_docker_log="$(<"$ephemeral_signal_log")"
assert_contains 'down --volumes --remove-orphans' "$ephemeral_signal_docker_log"
ephemeral_signal_project="$(sed -n 's/.*--project-name \([^ ]*\).*/\1/p' "$ephemeral_signal_log" | tail -n 1)"
[[ "$ephemeral_signal_project" == ai-ecommerce-agent-mvp0-ephemeral-* ]] ||
  fail "unexpected signal project: ${ephemeral_signal_project:-<none>}"
ephemeral_signal_volume="$(sed -n 's/.*volume=\([^]]*\).*/\1/p' "$ephemeral_signal_log" | tail -n 1)"
[[ "$ephemeral_signal_volume" == "${ephemeral_signal_project}-pg" ]] ||
  fail "unexpected signal volume: ${ephemeral_signal_volume:-<none>}"
[[ "$ephemeral_signal_project" != "$ephemeral_error_project" ]] ||
  fail 'ephemeral invocations reused the same Compose project'

printf 'MVP-0 ephemeral scopes: error=%s/%s signal=%s/%s default=%s/%s\n' \
  "$ephemeral_error_project" "$ephemeral_error_volume" \
  "$ephemeral_signal_project" "$ephemeral_signal_volume" \
  'ai-ecommerce-agent-mvp0' 'ai-ecommerce-agent-mvp0-postgres-data'
printf 'MVP-0 dynamic lifecycle checks: PASS\n'
