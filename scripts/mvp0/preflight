#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

host_processes=0
local_web=0
for arg in "$@"; do
  case "$arg" in
    --host-processes)
      host_processes=1
      ;;
    --local-web)
      local_web=1
      ;;
    -h|--help)
      cat <<'USAGE'
Usage: scripts/mvp0/preflight [--host-processes] [--local-web]

Checks Docker/Compose and the pinned PostgreSQL Compose configuration.
--host-processes additionally checks the Python/uv/Node/npm tools required by
the deterministic local-demo API and Web host processes.
--local-web validates the three-service Docker-only API/PostgreSQL/Web stack.
USAGE
      exit 0
      ;;
    *)
      printf 'ERROR: unknown option %s\n' "$arg" >&2
      exit 2
      ;;
  esac
done

mvp0_preflight_compose() {
  if (( local_web == 1 )); then
    mvp0_local_web_compose "$@"
  else
    mvp0_compose "$@"
  fi
}

require_command() {
  local command_name="$1"
  local install_hint="$2"
  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'ERROR: required command %s is missing. %s\n' "$command_name" "$install_hint" >&2
    exit 1
  }
}

version_parts() {
  local version="$1"
  version="${version#v}"
  version="${version%%-*}"
  local major="${version%%.*}"
  local rest="${version#*.}"
  local minor="${rest%%.*}"
  printf '%s %s\n' "$major" "$minor"
}

require_command docker 'Install Docker Desktop or Docker Engine and retry.'
mvp0_preflight_compose version >/dev/null 2>&1 || {
  printf 'ERROR: Docker Compose v2 is unavailable. Install/enable the Compose plugin.\n' >&2
  exit 1
}

compose_version="$(mvp0_preflight_compose version --short 2>/dev/null || mvp0_preflight_compose version 2>/dev/null)"
read -r compose_major compose_minor < <(version_parts "$compose_version")
if [[ ! "$compose_major" =~ ^[0-9]+$ || ! "$compose_minor" =~ ^[0-9]+$ ]] ||
  (( compose_major < 2 || (compose_major == 2 && compose_minor < 20) )); then
  printf 'ERROR: Docker Compose >= 2.20 is required for health/readiness handling; found %s.\n' "$compose_version" >&2
  exit 1
fi

docker info >/dev/null 2>&1 || {
  printf 'ERROR: Docker daemon is not reachable. Start Docker Desktop/Engine, then retry.\n' >&2
  exit 1
}

mvp0_require_repo
mvp0_preflight_compose config --quiet || {
  printf 'ERROR: compose.yaml is invalid or its environment values are incomplete.\n' >&2
  exit 1
}

configured_services="$(mvp0_preflight_compose config --services)"
configured_images="$(mvp0_preflight_compose config --images)"
if (( local_web == 1 )); then
  [[ "$configured_services" == $'postgres\napi\nweb' ]] || {
    printf 'ERROR: Docker-only local Web stack must contain exactly postgres, api and web; found:\n%s\n' \
      "$configured_services" >&2
    exit 1
  }
  expected_local_web_images="$(printf '%s\n' \
    "${MVP0_COMPOSE_PROJECT}-api" \
    "${MVP0_COMPOSE_PROJECT}-web" \
    'postgres:16.14-bookworm' | LC_ALL=C sort)"
  rendered_local_web_images="$(printf '%s\n' "$configured_images" | LC_ALL=C sort)"
  [[ "$rendered_local_web_images" == "$expected_local_web_images" ]] || {
    printf 'ERROR: Docker-only local Web stack has unexpected rendered images; found:\n%s\n' \
      "$configured_images" >&2
    exit 1
  }
  backend_base_image="$(awk '/^FROM[[:space:]]+/ { print $2; exit }' "$MVP0_ROOT_DIR/apps/backend/Dockerfile.local")"
  web_base_images="$(awk '/^FROM[[:space:]]+/ { print $2 }' "$MVP0_ROOT_DIR/apps/web/Dockerfile.local")"
  [[ "$backend_base_image" == 'python:3.13.14-slim-bookworm' &&
    "$web_base_images" == $'node:24.18.0-bookworm-slim\nnginx:1.29.1-alpine-slim' ]] || {
    printf 'ERROR: Docker-only local Web Dockerfile base images drifted from the pinned tuple.\n' >&2
    exit 1
  }
else
  # Existing host-process demo commands intentionally start only PostgreSQL;
  # the local-Web profile must be selected explicitly via --local-web.
  [[ "$configured_services" == 'postgres' ]] || {
    printf 'ERROR: default MVP-0 preflight must contain only postgres; found:\n%s\n' \
      "$configured_services" >&2
    exit 1
  }
  [[ "$configured_images" == 'postgres:16.14-bookworm' ]] || {
    printf 'ERROR: expected exactly the pinned image postgres:16.14-bookworm; found:\n%s\n' \
      "$configured_images" >&2
    exit 1
  }
fi

if (( host_processes == 1 )); then
  require_command uv 'Install uv 0.12.x or newer (the repository uses uv sync --locked).'
  uv_version="$(uv --version | awk '{print $2}')"
  read -r uv_major uv_minor < <(version_parts "$uv_version")
  if [[ ! "$uv_major" =~ ^[0-9]+$ || ! "$uv_minor" =~ ^[0-9]+$ ]] ||
    (( uv_major == 0 && uv_minor < 12 )); then
    printf 'ERROR: uv >= 0.12.0 is required; found %s.\n' "$uv_version" >&2
    exit 1
  fi
  backend_python="$MVP0_ROOT_DIR/apps/backend/.venv/bin/python"
  if [[ -x "$backend_python" ]]; then
    python_version="$("$backend_python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")')"
  else
    require_command python3 'Install Python 3.13.x or run uv sync --locked in apps/backend.'
    python_version="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}")')"
  fi
  if [[ "$python_version" != 3.13.* ]]; then
    printf 'ERROR: Python 3.13.x is required by apps/backend; found %s. Run uv sync --locked or install Python 3.13.x.\n' "$python_version" >&2
    exit 1
  fi
  web_package_json="$MVP0_ROOT_DIR/apps/web/package.json"
  [[ -f "$web_package_json" ]] || {
    printf 'ERROR: apps/web/package.json is missing; cannot verify the pinned Web engine tuple.\n' >&2
    exit 1
  }
  package_python="$backend_python"
  if [[ ! -x "$package_python" ]]; then
    require_command python3 'Install Python 3.13.x or run uv sync --locked in apps/backend.'
    package_python="$(command -v python3)"
  fi
  engine_tuple="$("$package_python" - "$web_package_json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as package_file:
    package = json.load(package_file)
engines = package.get("engines")
expected = ("24.18.0", "11.16.0")
actual = (engines.get("node"), engines.get("npm")) if isinstance(engines, dict) else (None, None)
if actual != expected:
    raise SystemExit(
        "apps/web/package.json must pin engines node=24.18.0 and npm=11.16.0"
    )
print(*expected)
PY
  )" || {
    printf 'ERROR: apps/web/package.json does not contain the required exact Node/npm engine tuple.\n' >&2
    exit 1
  }
  read -r required_node_version required_npm_version <<<"$engine_tuple"
  require_command node 'Install Node.js 24.18.0 for the local demo Web host process.'
  require_command npm 'Install npm 11.16.0 for the local demo Web host process.'
  node_version="$(node --version)"
  npm_version="$(npm --version)"
  if [[ "$node_version" != "v${required_node_version}" ]]; then
    printf 'ERROR: Node.js %s is required by apps/web/package.json; found %s.\n' \
      "$required_node_version" "$node_version" >&2
    exit 1
  fi
  if [[ "$npm_version" != "$required_npm_version" ]]; then
    printf 'ERROR: npm %s is required by apps/web/package.json; found %s.\n' \
      "$required_npm_version" "$npm_version" >&2
    exit 1
  fi
  printf '  Host tools: uv %s, Python %s, Node %s, npm %s\n' \
    "$uv_version" "$python_version" "$node_version" "$npm_version"
else
  printf '  Host process tools: not checked (use --host-processes before scripts/mvp0/demo)\n'
fi

if (( local_web == 1 )); then
  printf 'MVP-0 Docker-only local Web preflight: PASS\n'
else
  printf 'MVP-0 local PostgreSQL preflight: PASS\n'
fi
printf '  Docker Compose: %s\n' "$compose_version"
printf '  PostgreSQL image: postgres:16.14-bookworm\n'
printf '  Compose project: %s\n' "$MVP0_COMPOSE_PROJECT"
if (( local_web == 1 )); then
  printf '  Service topology: postgres + private api + loopback web\n'
else
  printf '  Service topology: postgres (deterministic API/Web remain host processes)\n'
fi
